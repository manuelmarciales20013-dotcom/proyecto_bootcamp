{
  "datasets": [
    {
      "name": "ds_kpis",
      "displayName": "KPIs Generales",
      "queryLines": [
        "SELECT\n",
        "  total_videos,\n",
        "  total_vistas_acumuladas,\n",
        "  promedio_vistas_por_video,\n",
        "  promedio_likes_por_video\n",
        "FROM\n",
        "  tiktok_data_eng.semantica.v_kpi_metricas_generales\n"
      ]
    },
    {
      "name": "ds_videos_region",
      "displayName": "Videos por Región",
      "queryLines": [
        "SELECT\n",
        "  region,\n",
        "  cantidad_videos,\n",
        "  total_vistas,\n",
        "  total_likes\n",
        "FROM\n",
        "  tiktok_data_eng.semantica.v_videos_por_region\n",
        "ORDER BY\n",
        "  cantidad_videos DESC\n",
        "LIMIT 5\n"
      ]
    },
    {
      "name": "ds_top5_autores",
      "displayName": "Top 5 Autores con más Likes",
      "queryLines": [
        "SELECT\n",
        "  author_username,\n",
        "  author_nickname,\n",
        "  total_likes,\n",
        "  total_vistas,\n",
        "  total_videos\n",
        "FROM\n",
        "  tiktok_data_eng.semantica.v_top5_autores_likes\n",
        "ORDER BY\n",
        "  total_likes DESC\n"
      ]
    },
    {
      "name": "ds_hashtags_vistos",
      "displayName": "Hashtags con Videos más Vistos",
      "queryLines": [
        "SELECT\n",
        "  hashtag,\n",
        "  total_vistas_acumuladas,\n",
        "  promedio_vistas_por_video,\n",
        "  total_videos_con_hashtag\n",
        "FROM\n",
        "  tiktok_data_eng.semantica.v_hashtags_mas_vistos\n",
        "ORDER BY\n",
        "  total_vistas_acumuladas DESC\n",
        "LIMIT 10\n"
      ]
    },
    {
      "name": "ds_hashtags_likeados",
      "displayName": "Hashtags con Videos más Likeados",
      "queryLines": [
        "SELECT\n",
        "  hashtag,\n",
        "  record_likes_un_video,\n",
        "  total_likes_acumulados,\n",
        "  promedio_likes_por_video,\n",
        "  total_videos_con_hashtag\n",
        "FROM\n",
        "  tiktok_data_eng.semantica.v_hashtags_mas_likeados\n",
        "ORDER BY\n",
        "  record_likes_un_video DESC\n",
        "LIMIT 10\n"
      ]
    },
    {
      "name": "ds_nube_hashtags",
      "displayName": "Frecuencia de Hashtags",
      "queryLines": [
        "SELECT\n",
        "  hashtag,\n",
        "  frecuencia_aparicion,\n",
        "  peso_vistas,\n",
        "  peso_likes\n",
        "FROM\n",
        "  tiktok_data_eng.semantica.v_nube_palabras_hashtags\n",
        "ORDER BY\n",
        "  frecuencia_aparicion DESC\n",
        "LIMIT 15\n"
      ]
    }
  ],
